{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dockproj manifest (project.json)",
  "type": "object",
  "required": ["schema_version", "id", "name", "inputs", "parameters", "seeds"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "parameters": { "type": "object" },
    "seeds": { "type": "object" }
  }
}
